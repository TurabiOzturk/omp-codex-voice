{
	"name": "omp-codex-voice",
	"version": "0.1.0",
	"private": true,
	"description": "Persistent streaming dictation for OMP using Codex OAuth",
	"keywords": [
		"omp-plugin",
		"pi-package",
		"voice",
		"dictation",
		"speech-to-text"
	],
	"license": "MIT",
	"contributors": [
		{
			"name": "Giuseppe Rodriguez",
			"url": "https://github.com/giuseppecrj"
		},
		"Igor Warzocha"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/TurabiOzturk/omp-codex-voice.git"
	},
	"homepage": "https://github.com/TurabiOzturk/omp-codex-voice#readme",
	"bugs": {
		"url": "https://github.com/TurabiOzturk/omp-codex-voice/issues"
	},
	"type": "module",
	"main": "./index.ts",
	"exports": {
		".": "./index.ts"
	},
	"engines": {
		"bun": ">=1.3.14",
		"node": ">=22.19.0"
	},
	"os": [
		"linux",
		"darwin"
	],
	"cpu": [
		"x64",
		"arm64"
	],
	"files": [
		"index.ts",
		"src/config.ts",
		"src/config-store.ts",
		"src/openai/constants.ts",
		"src/openai/header-record.ts",
		"src/openai/types.ts",
		"src/openai/websocket-connection.ts",
		"src/proxy-from-env.d.ts",
		"src/voice/auth.ts",
		"src/voice/binary.ts",
		"src/voice/helper.ts",
		"src/voice/helper-protocol.ts",
		"src/voice/shortcuts.ts",
		"src/voice/conversation/peer.ts",
		"src/voice/dictation/*.ts",
		"src/voice/bin/darwin-arm64/pi-codex-voice",
		"src/voice/bin/linux-x64/pi-codex-voice",
		"src/voice/rust/Cargo.toml",
		"src/voice/rust/Cargo.lock",
		"src/voice/rust/rust-toolchain.toml",
		"src/voice/rust/src",
		"src/voice/rust/vendor",
		"src/voice/rust/VENDORED.md",
		"README.md",
		"CHANGELOG.md",
		"LICENSE",
		"THIRD-PARTY-NOTICES.txt",
		"licenses"
	],
	"omp": {
		"name": "OMP Codex Voice",
		"version": "0.1.0",
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"check": "bun run lint && bun run typecheck && bun run test",
		"typecheck": "tsc --noEmit",
		"test": "bun test tests",
		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"dependencies": {
		"proxy-from-env": "2.1.0",
		"undici": "8.10.2"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-coding-agent": ">=18.12.0 <19",
		"@oh-my-pi/pi-tui": ">=18.12.0 <19"
	},
	"peerDependenciesMeta": {
		"@oh-my-pi/pi-coding-agent": {
			"optional": true
		},
		"@oh-my-pi/pi-tui": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@oh-my-pi/pi-coding-agent": "18.12.6",
		"@oh-my-pi/pi-tui": "18.12.6",
		"@types/bun": "1.3.14",
		"@types/node": "22.19.0",
		"typescript": "5.9.3"
	}
}
