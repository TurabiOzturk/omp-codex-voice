{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"index.ts",
			"src/config.ts",
			"src/config-store.ts",
			"src/openai/constants.ts",
			"src/openai/header-record.ts",
			"src/openai/types.ts",
			"src/openai/websocket-connection.ts",
			"src/voice/auth.ts",
			"src/voice/binary.ts",
			"src/voice/helper.ts",
			"src/voice/helper-protocol.ts",
			"src/voice/shortcuts.ts",
			"src/voice/conversation/peer.ts",
			"src/voice/dictation/**",
			"tests/**",
			"package.json",
			"tsconfig.json",
			"biome.json"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": false
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	}
}
